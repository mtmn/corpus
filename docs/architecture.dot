digraph corpus_architecture {
    graph [
        rankdir=LR
        bgcolor="#ffffff"
        pad=0.30
        nodesep=0.32
        ranksep=1.15
        splines=spline
        compound=true
        newrank=true
        outputorder=edgesfirst
        fontname="Intel Mono"
        fontcolor="#424242"
    ]

    node [
        shape=box
        style="rounded,filled"
        color="#424242"
        fillcolor="#ffffff"
        fontname="Intel Mono"
        fontsize=11
        fontcolor="#424242"
        margin="0.18,0.10"
        penwidth=1.0
        width=1.45
    ]

    edge [
        color="#424242"
        fontcolor="#424242"
        fontname="Intel Mono"
        fontsize=8
        arrowsize=0.65
        penwidth=1.0
    ]

    subgraph cluster_clients {
        label="Clients"
        labelloc=t
        labeljust=l
        style="rounded,filled"
        color="#424242"
        fillcolor="#ffffff"
        fontcolor="#424242"
        fontsize=11
        margin=16

        Browser
        Scrobbler
        Operator [label="Administrator"]
        Prometheus
        { rank=same; Browser; Scrobbler; Operator; Prometheus }
    }

    subgraph cluster_corpus {
        label="Corpus server  ·  PureScript on Node.js"
        labelloc=t
        labeljust=l
        style="rounded,filled"
        color="#424242"
        fillcolor="#ffffff"
        fontcolor="#424242"
        fontsize=11
        margin=18

        subgraph cluster_interfaces {
            label="Interfaces"
            labelloc=t
            labeljust=l
            style="rounded,filled"
            color="#424242"
            fillcolor="#ffffff"
            fontcolor="#424242"
            fontsize=9
            margin=12

            Frontend [label="Frontend\nElm"]
            API [label="API\nHTTP"]
            CLI
            { rank=same; Frontend; API; CLI }
        }

        subgraph cluster_services {
            label="Services"
            labelloc=t
            labeljust=l
            style="rounded,filled"
            color="#424242"
            fillcolor="#ffffff"
            fontcolor="#424242"
            fontsize=9
            margin=12

            Synchronizer [label="Sync"]
            Enricher [label="Metadata"]
            Artwork [label="Cover cache"]
            Query [label="Statistics"]
            Archiver [label="Backup"]
            Registrar [label="Registration"]
            Recommender [label="Similar tracks"]
            { rank=same; Synchronizer; Enricher; Artwork; Query; Archiver; Registrar; Recommender }
        }
    }

    subgraph cluster_ingestion {
        label="Listen sources"
        labelloc=t
        labeljust=l
        style="rounded,filled"
        color="#424242"
        fillcolor="#ffffff"
        fontcolor="#424242"
        fontsize=11
        margin=16

        ListenBrainz
        LastFM [label="Last.fm"]
        { rank=same; ListenBrainz; LastFM }
    }

    subgraph cluster_catalogs {
        label="Metadata and covers"
        labelloc=t
        labeljust=l
        style="rounded,filled"
        color="#424242"
        fillcolor="#ffffff"
        fontcolor="#424242"
        fontsize=11
        margin=16

        MusicBrainz
        Discogs
        CoverArchive [label="Cover Art\nArchive"]
        { rank=same; MusicBrainz; Discogs; CoverArchive }
    }

    subgraph cluster_persistence {
        label="Storage"
        labelloc=t
        labeljust=r
        style="rounded,filled"
        color="#424242"
        fillcolor="#ffffff"
        fontcolor="#424242"
        fontsize=11
        margin=16

        DuckDB [label="DuckDB\none file per user"]
        S3 [label="S3\ncovers and backups"]
        Users [label="users.json\nstatic users"]
        { rank=same; DuckDB; S3; Users }
    }

    subgraph cluster_integrations {
        label="Other services"
        labelloc=t
        labeljust=l
        style="rounded,filled"
        color="#424242"
        fillcolor="#ffffff"
        fontcolor="#424242"
        fontsize=11
        margin=16

        Cosine [label="cosine.club"]
        SMTP
        { rank=same; Cosine; SMTP }
    }

    Browser -> Frontend [label="HTTPS"]
    Scrobbler -> API [label="POST /1/submit-listens"]
    Operator -> API [label="/admin"]
    Operator -> CLI [label="commands"]
    Prometheus -> API [label="GET /metrics"]
    Frontend -> API [label="JSON"]

    API -> Query [label="/proxy and /stats"]
    API -> Artwork [label="/cover"]
    API -> Recommender [label="/similar"]
    API -> Registrar [label="registrations"]
    API -> DuckDB [label="listens"]
    CLI -> Users [label="users"]
    CLI -> DuckDB [label="tokens"]

    Synchronizer -> ListenBrainz [dir=both]
    Synchronizer -> LastFM [dir=both]
    Synchronizer -> DuckDB
    Enricher -> MusicBrainz [dir=both]
    Enricher -> Discogs [dir=both]
    Enricher -> LastFM [dir=both]
    Enricher -> DuckDB
    Artwork -> CoverArchive
    Artwork -> Discogs
    Artwork -> LastFM
    Artwork -> S3 [dir=both]
    Query -> DuckDB [dir=both]
    Archiver -> DuckDB
    Archiver -> S3
    Registrar -> DuckDB
    Registrar -> SMTP
    Recommender -> Cosine [dir=both]

    { rank=same; ListenBrainz; LastFM; MusicBrainz; Discogs; CoverArchive; DuckDB; S3; Users; Cosine; SMTP }
}
